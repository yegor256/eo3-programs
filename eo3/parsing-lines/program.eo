+alias eo3.parsing-lines.consumed
+alias eo3.parsing-lines.printed
+alias eo3.parsing-lines.ring-buffer
+home https://github.com/yegor256/eo3-programs
+package eo3.parsing-lines
+spdx SPDX-FileCopyrightText: Copyright (c) 2022-2026 Yegor Bugayenko
+spdx SPDX-License-Identifier: MIT
+unlint unit-test-missing
+version 0.0.1

[args] > program
  malloc.empty > @
    [m] >>
      open. > @
        fs.file "eo3/parsing-lines/input.txt"
        "r"
        [f] >>
          consumed > @
            f.read 10
            ring-buffer.empty m
            printed
