+alias eo3.parsing-lines.assert
+alias eo3.parsing-lines.max
+alias eo3.parsing-lines.min
+home https://github.com/yegor256/eo3-programs
+package eo3.parsing-lines
+spdx SPDX-FileCopyrightText: Copyright (c) 2022-2026 Yegor Bugayenko
+spdx SPDX-License-Identifier: MIT
+version 0.0.1

[block start length] > ring-buffer
  content > @

  [m] > empty
    ring-buffer > @
      m
      0
      0

  [] > is-empty
    length.eq 0 > @

  [] > cursor
    if. > @
      length.eq 0
      start
      mod.
        start.plus length
        block.size

  [] > is-flipped
    gt. > @
      start.plus length
      block.size

  [dec] > beheaded
    ring-buffer > @
      block
      mod.
        start.plus dec
        block.size
      length.minus dec

  [] > content
    as-bytes. > @
      if.
        is-flipped
        concat.
          block.slice
            start
            block.size.minus start
          block.slice
            0
            cursor
        block.slice start length

  [size] > fit
    seq * > @
      if.
        lte.
          size
          block.size
        true
        seq *
          block.size > before!
          is-flipped > flipped!
          cursor > c!
          block.resized size
          if.
            flipped.as-bool
            seq *
              min > tail
                block.size.minus before
                c.as-number
              block.copy 0 before tail
              block.copy
                tail
                0
                max
                  0
                  c.as-number.minus tail
            true
      ring-buffer block start length

  [data] > with
    seq * > @
      if.
        is-flipped.
          fit
            data.size.plus length
        block.write cursor data
        seq *
          write.
            block
            cursor
            data.slice
              0
              min
                data.size
                block.size.minus cursor
          write.
            block
            0
            data.slice
              min
                data.size
                block.size.minus cursor
              max
                0
                data.size.minus
                  block.size.minus cursor
      ring-buffer
        block
        start
        length.plus data.size

  [] +> says-empty-is-empty
    malloc.of > @
      200
      [m]
        is-empty. > @
          ring-buffer.empty m

  [] +> says-empty-is-not-flipped
    malloc.of > @
      33
      [m]
        not. > @
          is-flipped.
            ring-buffer.empty m

  [] +> says-full-buffer-is-not-flipped
    malloc.of > @
      5
      [m]
        not. > @
          is-flipped.
            with.
              ring-buffer.empty m
              "hello"

  [] +> says-beheaded-buffer-is-not-flipped
    malloc.of > @
      12
      [m]
        not. > @
          is-flipped.
            beheaded.
              with.
                ring-buffer.empty m
                "hello, dude"
              3

  [] +> says-cursor-in-full-buffer-points-to-start
    malloc.of > @
      9
      [m]
        assert > @
          0
          cursor.
            with.
              ring-buffer.empty m
              "some text"

  [] +> says-cursor-points-to-start-in-beheaded-buffer
    malloc.of > @
      7
      [m]
        assert > @
          0
          cursor.
            beheaded.
              with.
                ring-buffer.empty m
                "just me"
              3

  [] +> says-cursor-of-empty
    malloc.of > @
      42
      [m]
        assert > @
          0
          cursor.
            ring-buffer.empty m

  [] +> says-cursor-of-non-empty
    malloc.of > @
      42
      [m]
        assert > @
          5
          cursor.
            with.
              ring-buffer.empty m
              "hello".as-bytes

  [] +> builds-content-of-empty
    malloc.of > @
      17
      [m]
        assert > @
          0
          size.
            content.
              ring-buffer.empty m

  [] +> makes-simple-with
    malloc.of > @
      42
      [m]
        assert > @
          5
          size.
            content.
              with.
                ring-buffer.empty m
                "hello".as-bytes

  [] +> makes-buffer-full
    malloc.of > @
      1
      [m]
        assert > @
          48
          size.
            content.
              with.
                with.
                  with.
                    ring-buffer.empty m
                    "0123456789abcdef".as-bytes
                  "0123456789abcdef".as-bytes
                "0123456789abcdef".as-bytes

  [] +> makes-simple-double-with
    malloc.of > @
      42
      [m]
        assert > @
          "hello, world!"
          string
            content.
              with.
                with.
                  ring-buffer.empty m
                  "hello".as-bytes
                ", world!".as-bytes

  [] +> makes-with-flipping
    malloc.of > @
      12
      [m]
        assert > @
          10
          size.
            content.
              with.
                ring-buffer m 8 6
                "abcd".as-bytes

  [] +> makes-simple-empty-with
    malloc.empty > @
      [m]
        assert > @
          5
          size.
            content.
              with.
                ring-buffer.empty m
                "hello".as-bytes

  [] +> makes-simple-beheaded
    malloc.of > @
      42
      [m]
        assert > @
          "llo, world!"
          content.
            beheaded.
              with.
                ring-buffer.empty m
                "hello, world!".as-bytes
              2

  [] +> makes-non-flipped-buffer-fit
    malloc.of > @
      10
      [m]
        assert > @
          "one two"
          content.
            fit.
              with.
                ring-buffer.empty m
                "one two".as-bytes
              20

  [] +> makes-flipped-buffer-fit
    malloc.of > @
      10
      [m]
        assert > @
          "rt text tail"
          content.
            fit.
              with.
                beheaded.
                  with.
                    ring-buffer.empty m
                    "short text".as-bytes
                  3
                " tail"
              20

  [] +> enlarges-flipped-buffer
    malloc.of > @
      9
      [m]
        assert > @
          "thingss that work"
          content.
            with.
              with.
                beheaded.
                  with.
                    ring-buffer.empty m
                    "something".as-bytes
                  4
                "ss"
              " that work"

  [] +> makes-flip-after-beheading
    malloc.of > @
      13
      [m]
        assert > @
          " world!ABCDEF"
          content.
            with.
              beheaded.
                with.
                  ring-buffer.empty m
                  "hello, world!".as-bytes
                6
              "ABCDEF"

  [] +> makes-with-and-reads
    malloc.empty > @
      [m]
        assert > @
          "John Malkovich"
          string
            content.
              with.
                with.
                  with.
                    ring-buffer.empty m
                    "John".as-bytes
                  " ".as-bytes
                "Malkovich".as-bytes

  [] +> makes-cuts-off-head
    malloc.empty > @
      [m]
        assert > @
          "Lebowski"
          string
            content.
              beheaded.
                with.
                  ring-buffer.empty m
                  "Jeff Lebowski".as-bytes
                5
