+alias eo3.parsing-lines.assert
+home https://github.com/yegor256/eo3-programs
+package eo3.parsing-lines
+spdx SPDX-FileCopyrightText: Copyright (c) 2022-2026 Yegor Bugayenko
+spdx SPDX-License-Identifier: MIT
+version 0.0.1

[bytes needle] > index-of-byte
  if. > @
    bytes.size.eq 0
    -1
    if.
      eq.
        bytes.slice 0 1
        needle
      0
      if.
        next.as-number.lt 0
        next.as-number
        next.as-number.plus 1
  index-of-byte > next!
    bytes.slice 1 (bytes.size.minus 1)
    needle

  [] +> finds-one-byte
    assert > @
      6
      index-of-byte
        "Hello, друг!".as-bytes
        " ".as-bytes

  [] +> finds-first-byte
    assert > @
      0
      index-of-byte
        "John Malkovich".as-bytes
        "J".as-bytes

  [] +> finds-second-byte
    assert > @
      1
      index-of-byte
        "John Malkovich".as-bytes
        "o".as-bytes

  [] +> doesnt-find-anything
    lt. > @
      index-of-byte
        "John Malkovich".as-bytes
        "\n".as-bytes
      0

  [] +> doesnt-find-anything-in-empty-bytes
    lt. > @
      index-of-byte
        --
        42-
      0
