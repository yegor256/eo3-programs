+alias eo3.parsing-lines.assert
+home https://github.com/yegor256/eo3-programs
+package eo3.parsing-lines
+spdx SPDX-FileCopyrightText: Copyright (c) 2022-2026 Yegor Bugayenko
+spdx SPDX-License-Identifier: MIT
+version 0.0.1

[txt width] > fixed
  if. > @
    txt.length.gt width
    string.printf *1
      "%s..."
      slice.
        txt
        0
        width.minus 3
    if.
      txt.length.lt width
      chained.
        txt
        *
          repeated.
            " "
            width.minus txt.length
      txt

  [] +> makes-text-shorter
    assert > @
      "Михаил Афанась..."
      fixed
        "Михаил Афанасьевич"
        17

  [] +> makes-text-longer
    assert > @
      "Булгаков    "
      fixed
        "Булгаков"
        12

  [] +> keeps-text-same-size
    assert > @
      "Дюма"
      fixed
        "Дюма"
        4

  [] +> makes-empty-text-longer
    assert > @
      "    "
      fixed
        ""
        4

  [] +> formats-different-cases
    each. > @
      list.
        *
          *
            "Oscar Fingal O'ls..."
            "Oscar Fingal O'ls Wilde"
            20
          *
            "Мих..."
            "Михаил Афанасьевич Булгаков"
            6
      [case]
        assert > @
          case.at 0
          fixed
            case.at 1
            case.at 2
